# ============================================================
# Mercury Medet CRM — Environment Configuration
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
# ============================================================

# === БАЗА ДАННЫХ ===
DB_USER=mercury
DB_PASSWORD=ЗАМЕНИТЕ_НА_НАДЁЖНЫЙ_ПАРОЛЬ
DB_NAME=mercury_medet

# === BACKEND ===
# ОБЯЗАТЕЛЬНО: минимум 32 символа, случайная строка
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_МИН_32_СИМВОЛА
JWT_EXPIRES_IN=7d
# URL фронтенда (для CORS). Укажите ваш домен:
FRONTEND_URL=https://ВАШ_ДОМЕН

# === ПЕРВЫЙ АДМИНИСТРАТОР ===
# Создаётся автоматически при первом запуске
ADMIN_PHONE=77700000000
ADMIN_PASSWORD=ваш_надёжный_пароль
ADMIN_FIRST_NAME=Администратор
ADMIN_LAST_NAME=Системы

# === GREEN API (WhatsApp верификация) ===
# Получите аккаунт на https://green-api.com
GREEN_API_URL=https://api.green-api.com
GREEN_API_ID_INSTANCE=ВАШ_ID_INSTANCE
GREEN_API_TOKEN_INSTANCE=ВАШ_TOKEN_INSTANCE
WHATSAPP_SEND_INTERVAL_MS=5000
WHATSAPP_MAX_PENDING_MESSAGES=20

# === ПОРТЫ ===
APP_PORT=80

# === СИНХРОНИЗАЦИЯ ВОЛЕЙБОЛА ===
VOLLEYBALL_SYNC_ENABLED=false
VOLLEYBALL_SYNC_URL=http://volleyball-sync:4100
SYNC_HMAC_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_МИН_32_СИМВОЛА
MERCURY_SYNC_SECTION_NAME=Волейбол
